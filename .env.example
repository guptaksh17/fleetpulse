# Copy to .env and change every value. Never commit .env.
JWT_SECRET=change-me-to-a-long-random-string
FP_ADMIN_PASSWORD=change-me-admin
FP_MANAGER_PASSWORD=change-me-manager
FP_VIEWER_PASSWORD=change-me-viewer
RATE_LIMIT_PER_MINUTE=300
# Optional: fleet assistant LLM (free tier at console.groq.com). Without it the assistant uses its rules fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
